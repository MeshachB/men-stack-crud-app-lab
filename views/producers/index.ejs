<!DOCTYPE html>
<html>
<head>
  <title>GOAT Producers</title>
</head>
<body>
  <h1>Goat Producers</h1>

  <ul>
    <% producers.forEach((producer) => { %>
      <li>
        <strong><%= producer.name %></strong> – <%= producer.style %> from <%= producer.hometown %>

        <!-- Edit Link -->
        <a href="/producers/<%= producer._id %>/edit">Edit</a>

        <!-- Delete Form -->
        <form action="/producers/<%= producer._id %>?_method=DELETE" method="POST" style="display:inline;">
          <button type="submit" onclick="return confirm('Are you sure you want to delete this GOAT?')">
            Delete Producer
          </button>
        </form>
      </li>
    <% }) %>
  </ul>

  <!-- Link to New Form -->
  <a href="/producers/new">Add a New Producer</a>
</body>
</html>

