<!DOCTYPE html>
<html>
<head>
  <title>GOAT Producers</title>
</head>
<body>
  <h1>GOAT Hip-Hop Producers</h1>

  <a href="/producers/new">➕ Add a New Producer</a>

  <ul>
    <% producers.forEach(producer => { %>
      <li>
        <strong><%= producer.name %></strong><br>
        Hometown: <%= producer.hometown %><br>
        Era: <%= producer.era %><br>
        Style: <%= producer.style %>
      </li>
      <br>
    <% }) %>
  </ul>
  <% producers.forEach(producer => { %>
  <li>
    <a href="/producers/<%= producer._id %>"><%= producer.name %></a>
  </li>
<% }) %>
<form action="/producers/<%= producer._id %>?_method=DELETE" method="POST">
  <button type="submit" onclick="return confirm('Are you sure you want to delete this GOAT?')">
    Delete Producer
  </button>
</form>


</body>
</html>
